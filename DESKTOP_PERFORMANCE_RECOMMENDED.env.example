# GAIA-AI v1.0-RC2 recommended desktop-performance profile
# Copy to a private .env and edit locally; never package the private file.
GAIA_HARDWARE_PROFILE=desktop_performance
GAIA_PERFORMANCE_PROFILE=performance
GAIA_SAFE_MODE=false
GAIA_RESOURCE_GOVERNOR_REFRESH_SECONDS=30
GAIA_MAX_CONCURRENT_LLM_REQUESTS=1
GAIA_OLLAMA_KEEP_ALIVE=10m
GAIA_LLM_CONTEXT=8192
GAIA_AUTO_MEMORY_ENABLED=false
LUMEN_PROACTIVE_ENABLED=false
GAIA_REMOTE_HOST_ENABLED=true
GAIA_LAN_ENABLED=false
GAIA_MEMORY_DB=
GAIA_HOME=
LUMEN_SECRET=cambia-este-token-por-uno-largo-y-privado
