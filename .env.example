# LUMEN v0.2 - copia como .env en la raiz del proyecto.
# No subas este archivo con claves reales.

# Ejecucion y seguridad local
LUMEN_ENV=development
LUMEN_LOG_LEVEL=INFO
LUMEN_HOST=127.0.0.1
LUMEN_PORT=8090
LUMEN_CORE_URL=http://localhost:8090
LUMEN_SECRET=CAMBIA_ESTE_TOKEN_LOCAL_POR_UNO_LARGO_Y_ALEATORIO
LUMEN_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Backend LLM: ollama | openai | anthropic | mock
# mock solo valida el flujo tecnico; no es una IA conversacional real.
LUMEN_LLM_BACKEND=ollama
LUMEN_LLM_MODEL=llama3.1
LUMEN_LLM_TIMEOUT_SECONDS=120
OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=TU_CLAVE_AQUI
# ANTHROPIC_API_KEY=TU_CLAVE_AQUI

# Voz: push-to-talk estable a nivel de flujo, requiere validar hardware local.
LUMEN_STT_ENABLED=true
LUMEN_WHISPER_MODEL=base
LUMEN_MAX_AUDIO_UPLOAD_MB=20
LUMEN_TTS_ENABLED=true
LUMEN_TTS_ENGINE=edge
LUMEN_TTS_VOICE=es-MX-DaliaNeural

# Memoria
# La extraccion automatica es experimental y queda apagada para evitar facts incorrectos.
LUMEN_AUTO_FACTS_ENABLED=false

# Backups
LUMEN_BACKUP_ENABLED=true
LUMEN_BACKUP_INTERVAL_HOURS=24
LUMEN_BACKUP_CHECK_MINUTES=60
LUMEN_MAX_BACKUPS=30

# Proactividad
# El polling y la prueba manual funcionan. La generacion automatica queda apagada por estabilidad.
LUMEN_PROACTIVE_ENABLED=false
LUMEN_PROACTIVE_POLL_SECONDS=15
LUMEN_PROACTIVE_RULE_CHECK_SECONDS=300
