# Copia este archivo como .env y sustituye LUMEN_SECRET por un secreto largo y privado.
# Los valores en blanco para rutas significan "usar el default".
LUMEN_ENV=development
LUMEN_ASSISTANT_NAME=GAIA
LUMEN_SECRET=cambia-este-token-por-uno-largo-y-privado
LUMEN_HOST=127.0.0.1
LUMEN_PORT=8090
LUMEN_CORE_URL=http://localhost:8090
LUMEN_CORS_ORIGINS=http://localhost,http://127.0.0.1
LUMEN_LOG_LEVEL=INFO

# Motor recomendado: DeepSeek-Harness + Ollama local. GAIA no descarga modelos automáticamente.
LUMEN_LLM_BACKEND=deepseek-harness
LUMEN_LLM_MODEL=qwen3.5:4b
LUMEN_LLM_PROFILE=auto
OLLAMA_URL=http://localhost:11434
GAIA_DSH_BASE_URL=http://localhost:11434/v1
GAIA_DSH_HOME=
GAIA_DSH_WORKSPACE=
GAIA_DSH_PROFILE=sdk-minimal
GAIA_DSH_PROVIDER=deepseek-official
GAIA_DSH_REQUEST_TIMEOUT_SECONDS=600
GAIA_DSH_FALLBACK_TO_OLLAMA=true
LUMEN_LLM_TIMEOUT_SECONDS=600
GAIA_POST_ACTION_LLM_TIMEOUT=30
GAIA_CLIENT_ACTION_TIMEOUT=60
GAIA_MAX_CONCURRENT_LLM_REQUESTS=1
LUMEN_LLM_STREAM_ENABLED=true
LUMEN_LLM_HIDE_REASONING=true
GAIA_MODEL_FAST=qwen3.5:4b
GAIA_MODEL_NORMAL=qwen3.5:4b
GAIA_MODEL_REASONING=qwen3.5:4b
GAIA_MODEL_CODE=qwen3.5:4b
GAIA_MODEL_FALLBACK=
# Perfiles explícitos: auto detecta de forma conservadora; balanced es el recomendado para laptop.
GAIA_HARDWARE_PROFILE=auto
GAIA_PERFORMANCE_PROFILE=balanced
# RC2: true pauses automation/actions and requires restart to exit.
GAIA_SAFE_MODE=false
# Bounded governor refresh: 15-300 seconds; default 30.
GAIA_RESOURCE_GOVERNOR_REFRESH_SECONDS=30
GAIA_OLLAMA_KEEP_ALIVE=10m
GAIA_LLM_CONTEXT=4096
GAIA_LLM_RETRY_COUNT=1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Acciones: el Core clasifica; el cliente local valida y ejecuta allowlists.
LUMEN_ACTION_ENGINE_ENABLED=true
LUMEN_ACTION_MAX_LEVEL=2
LUMEN_ACTION_CONFIRM_LEVEL=3
GAIA_ACTION_PLAN_MAX=3
GAIA_ACTION_CONFIRM_POLICY=CONFIRM_EXECUTION
GAIA_PROJECTS_FILE=projects.json
GAIA_DEFAULT_PROJECT=.
GAIA_ACTION_MAX_OUTPUT=6000

# Tokens de dispositivo: se muestra el token claro únicamente al crearlo.
GAIA_DEVICE_TOKENS_ENABLED=true
GAIA_DEVICE_TOKEN_TTL_DAYS=365

# GAIA_VAULT: memoria y backups persistentes cuando el volumen existe.
# GAIA_HOME es el alias histórico del root del Vault.
GAIA_HOME=
GAIA_VAULT=
GAIA_DATA_DIR=
# Optional explicit Vault/database path; blank uses the resolved local/Vault fallback.
GAIA_MEMORY_DB=
# Migration database strategies are selected only in tools/gaia_migrate.py:
# CLONE_TO_TARGET, REUSE_EXISTING_EXTERNAL_VAULT, CLONE_TO_NEW_VAULT, KEEP_TARGET_CONFIG
GAIA_BACKUP_DIR=
GAIA_LOG_DIR=

# Voz, memoria y continuidad.
LUMEN_STT_ENABLED=true
LUMEN_WHISPER_MODEL=base
LUMEN_MAX_AUDIO_UPLOAD_MB=20
LUMEN_TTS_ENABLED=true
LUMEN_TTS_ENGINE=edge
LUMEN_TTS_VOICE=es-MX-DaliaNeural
GAIA_MIC_PREFERENCE_FILE=
LUMEN_AUTO_FACTS_ENABLED=false
GAIA_AUTO_MEMORY_ENABLED=false
LUMEN_BACKUP_ENABLED=true
LUMEN_BACKUP_INTERVAL_HOURS=24
LUMEN_BACKUP_CHECK_MINUTES=60
LUMEN_MAX_BACKUPS=30
GAIA_BRAIN_BACKUP_ENABLED=false
GAIA_BRAIN_BACKUP_INTERVAL_HOURS=168
GAIA_BRAIN_MAX_BACKUPS=10
GAIA_SESSION_SUMMARY_EVERY_TURNS=8
# Presupuesto laptop por defecto: 4K-ish de contexto de memoria y 3–8 elementos.
# Para un desktop configurado, aumenta explícitamente estos valores.
GAIA_MEMORY_CONTEXT_MAX_CHARS=4096
GAIA_MEMORY_RELEVANCE_LIMIT=8
GAIA_TRUSTED_FOLDERS_TTL_SECONDS=30
GAIA_AUDIO_RETENTION=false
GAIA_ACTIVE_SESSION_SECONDS=30

# Personalidad moderada: rango 0–3; no concede permisos ni autoridad.
GAIA_HUMOR_LEVEL=2
GAIA_SARCASM_LEVEL=2

# Privacidad y logs.
GAIA_PRIVACY_MODE=normal
GAIA_LOG_MAX_BYTES=5242880
GAIA_LOG_BACKUP_COUNT=5

# Proactividad: apagada por defecto; las señales deben sostenerse.
LUMEN_PROACTIVE_ENABLED=false
GAIA_PROACTIVE_MUTED=true
LUMEN_PROACTIVE_POLL_SECONDS=15
LUMEN_PROACTIVE_RULE_CHECK_SECONDS=60
GAIA_PROACTIVE_COOLDOWN_MINUTES=30
GAIA_PROACTIVE_QUIET_START=23
GAIA_PROACTIVE_QUIET_END=8
GAIA_PROACTIVE_MAX_DAILY=3
GAIA_PROACTIVE_CPU_THRESHOLD=90
GAIA_PROACTIVE_MEMORY_THRESHOLD=90
GAIA_PROACTIVE_SUSTAINED_SECONDS=120
GAIA_PROACTIVE_EVENT_COOLDOWN_MINUTES=60
GAIA_PROACTIVE_LONG_SESSION_HOURS=4

# Event Engine v0.8: OFF por defecto; los eventos son datos y no conceden autoridad.
GAIA_AUTOMATION_MODE=OFF
GAIA_AUTOMATION_QUEUE_MAX=256
GAIA_AUTOMATION_POLL_SECONDS=30
GAIA_AUTOMATION_MAX_CHAIN_DEPTH=4
GAIA_AUTOMATION_DEDUP_SECONDS=30
GAIA_AUTOMATION_MAX_EVENT_BYTES=8192
GAIA_AUTOMATION_MAX_DAILY_RUNS=50
GAIA_AUTOMATION_MAX_RULES=50
GAIA_AUTOMATION_MAX_NOTIFICATIONS=200
GAIA_AUTOMATION_EVENT_RETENTION_DAYS=7
GAIA_AUTOMATION_WATCHER_INTERVAL_SECONDS=30
GAIA_AUTOMATION_QUIET_START=0
GAIA_AUTOMATION_QUIET_END=0
GAIA_AUTOMATION_QUIET_HOURS_ENABLED=false
GAIA_AUTOMATION_PROACTIVE_LLM_PER_MINUTE=1

# LAN es opt-in; escucha fuera de localhost solo con este switch y TLS externo/red confiable.
GAIA_LAN_ENABLED=false

# v1.1 optional foundation: all false preserves RC6 compatibility and lazy loading.
GAIA_FEATURE_MCP=false
GAIA_FEATURE_BROWSER=false
GAIA_FEATURE_VOICE_V2=false
GAIA_FEATURE_VAD=false
GAIA_FEATURE_MEM0=false
GAIA_FEATURE_CODING_WORKER=false
GAIA_FEATURE_COMPUTER_USE=false
GAIA_FEATURE_GRAPH_MEMORY=false
GAIA_FEATURE_VISUALIZER=false
GAIA_FEATURE_REALTIME_TRANSPORT=false
